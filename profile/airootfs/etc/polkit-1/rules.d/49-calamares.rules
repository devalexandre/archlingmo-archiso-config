polkit.addRule(function(action, subject) {
    /* Allow the live user or wheel members to launch Calamares via pkexec. */
    var allowedActions = [
        "io.calamares.calamares.pkexec.run",
        "org.calamares.calamares"
    ];
    if (allowedActions.indexOf(action.id) !== -1 &&
        (subject.user === "lingmo" || subject.isInGroup("wheel"))) {
        return polkit.Result.YES;
    }
});
